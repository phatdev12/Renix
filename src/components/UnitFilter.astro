---
/* "Tất cả / N5 1 2 … 12 / N4 13 … 17" pills, grouped by course. The selection lives in localStorage,
   so shell.ts marks the active ones; a course label selects that whole course. */
import { COURSES, UNITS } from '../lib/course';

interface Props { id: string; wrap?: boolean }
const { id, wrap } = Astro.props;
---
<div id={id} class={'unit-pills' + (wrap ? ' wrap' : '')} data-unit-filter>
  <button type="button" class="all on" data-u="all" title="Ôn tất cả Unit">Tất cả</button>
  {COURSES.map((c) => (
    <span class="pill-group">
      <button type="button" class="grp" data-course={c.key} title={`${c.name} — chọn cả ${c.short}`}>{c.short}</button>
      {UNITS.filter((u) => u.course === c.key).map((u) => (
        <button type="button" data-u={u.id} title={`Unit ${u.id} — ${u.titleVi}`}>{u.id}</button>
      ))}
    </span>
  ))}
</div>
