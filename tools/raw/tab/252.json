{"data":"<div class=\"w-100 ck-content\">\n        <p style=\"text-align:center;\"><strong>&nbsp; Unit 14\u30fb\u8a9e\u5f59\u30ea\u30b9\u30c8\uff0811\u500b\uff09<\/strong><\/p><figure class=\"table\" style=\"width:72.14%;\"><table class=\"ck-table-resized\"><colgroup><col style=\"width:36.05%;\"><col style=\"width:29.31%;\"><col style=\"width:34.64%;\"><\/colgroup><tbody><tr><td style=\"background-color:hsl(0, 0%, 90%);border:0.5pt solid #000000;padding:0pt 5.4pt;vertical-align:top;\"><p style=\"text-align:center;\"><strong>\u3053\u3068\u3070<\/strong><\/p><\/td><td style=\"background-color:hsl(0, 0%, 90%);border:0.5pt solid #000000;padding:0pt 5.4pt;vertical-align:top;\"><p style=\"text-align:center;\"><strong>\u6f22\u5b57<\/strong><\/p><\/td><td style=\"background-color:hsl(0, 0%, 90%);border:0.5pt solid #000000;padding:0pt 5.4pt;vertical-align:top;\"><p style=\"text-align:center;\"><strong>\u30d9\u30c8\u30ca\u30e0\u8a9e<\/strong><\/p><\/td><\/tr><tr><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u3057\u3085\u307f<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u8da3\u5473<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">s\u1edf th\u00edch<\/td><\/tr><tr><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">J\u30dd\u30c3\u30d7<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">&nbsp;<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">J-pop<\/td><\/tr><tr><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u306f\u3058\u3081\u307e\u3059<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u59cb\u3081\u307e\u3059<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">b\u1eaft \u0111\u1ea7u<\/td><\/tr><tr><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u306a\u307e\u306eN<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u751f\u306eN<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">N t\u01b0\u01a1i, s\u1ed1ng<\/td><\/tr><tr><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u30e2\u30fc\u30c4\u30a1\u30eb\u30c8<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">&nbsp;<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">Mozart<\/td><\/tr><tr><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u306a\u3089\u3063\u3066\u3044\u307e\u3059<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u7fd2\u3063\u3066\u3044\u307e\u3059<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">h\u1ecdc<\/td><\/tr><tr><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u30d0\u30f3\u30c9<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">&nbsp;<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">ban nh\u1ea1c<\/td><\/tr><tr><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u30d9\u30fc\u30b9<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">&nbsp;<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">bass<\/td><\/tr><tr><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;vertical-align:top;\">\uff08\u30d4\u30a2\u30ce\u3092\uff09\u3072\u304d\u307e\u3059<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;vertical-align:top;\">&nbsp;<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;vertical-align:top;\">ch\u01a1i (piano)<\/td><\/tr><tr><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u304d\u3087\u304f<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u66f2<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">b\u1ea3n nh\u1ea1c<\/td><\/tr><tr><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u3048\u3093\u305d\u3046\u3057\u307e\u3059<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">\u6f14\u594f\u3057\u307e\u3059<\/td><td style=\"border:0.5pt solid #000000;padding:0pt 5.4pt;\">di\u1ec5n<\/td><\/tr><\/tbody><\/table><\/figure><p>&nbsp;<\/p><p style=\"text-align:center;\"><strong>Unit 14\u30fb\u6587\u578b\u30ea\u30b9\u30c8<\/strong><\/p><p>&nbsp;<\/p><p><strong>A. &nbsp;<u>M\u1eabu ng\u1eef ph\u00e1p ch\u00ednh<\/u><\/strong><\/p><ol><li><strong>\u8f9e\u66f8\u5f62\uff08V\u308b\uff09<\/strong><\/li><\/ol><p>Th\u1ec3 nguy\u00ean d\u1ea1ng (Th\u1ec3 t\u1eeb \u0111i\u1ec3n). \u0110\u00e2y l\u00e0 th\u1ec3 c\u01a1 b\u1ea3n c\u1ee7a \u0111\u1ed9ng t\u1eeb v\u00e0 l\u00e0 th\u1ec3 \u0111\u01b0\u1ee3c vi\u1ebft trong t\u1eeb \u0111i\u1ec3n.<\/p><figure class=\"table\" style=\"width:63.14%;\"><table class=\"ck-table-resized\"><colgroup><col style=\"width:33.2%;\"><col style=\"width:34.83%;\"><col style=\"width:31.97%;\"><\/colgroup><tbody><tr><td style=\"background-color:hsl(0, 0%, 90%);vertical-align:top;\"><p style=\"text-align:center;\"><strong>I\u30b0\u30eb\u30fc\u30d7<\/strong><\/p><\/td><td style=\"background-color:hsl(0, 0%, 90%);vertical-align:top;\"><p style=\"text-align:center;\"><strong>II\u30b0\u30eb\u30fc\u30d7<\/strong><\/p><\/td><td style=\"background-color:hsl(0, 0%, 90%);vertical-align:top;\"><p style=\"text-align:center;\"><strong>III\u30b0\u30eb\u30fc\u30d7<\/strong><\/p><\/td><\/tr><tr><td style=\"vertical-align:top;\"><p>\u304b\u304d\u307e\u3059\u2192\u304b<strong>\u304f<\/strong><\/p><p>\u3088\u307f\u307e\u3059\u2192\u3088<strong>\u3080<\/strong><\/p><p>\u3068\u308a\u307e\u3059\u2192\u3068<strong>\u308b<\/strong><\/p><p>\u3059\u3044\u307e\u3059\u2192\u3059<strong>\u3046<\/strong><\/p><p>\u3044\u305d\u304e\u307e\u3059\u2192\u3044\u305d<strong>\u3050<\/strong><\/p><p>\u3042\u305d\u3073\u307e\u3059\u2192\u3042\u305d<strong>\u3076<\/strong><\/p><p>\u307e\u3061\u307e\u3059\u2192\u307e<strong>\u3064<\/strong><\/p><p>\u306f\u306a\u3057\u307e\u3059\u2192\u306f\u306a<strong>\u3059<\/strong><\/p><\/td><td style=\"vertical-align:top;\"><p>\u305f\u3079\u307e\u3059\u2192\u305f\u3079<strong>\u308b<\/strong><\/p><p>\u306d\u307e\u3059\u2192\u306d<strong>\u308b<\/strong><\/p><p>\u307f\u307e\u3059\u2192\u307f<strong>\u308b<\/strong><\/p><p>\u7740\uff08\u304d\uff09\u307e\u3059\u2192\u7740\uff08\u304d\uff09<strong>\u308b<\/strong><\/p><\/td><td style=\"vertical-align:top;\"><p>\u3057\u307e\u3059\u2192<strong>\u3059\u308b<\/strong><\/p><p>\u6765\u307e\u3059\u2192<strong>\u304f\u308b<\/strong><\/p><\/td><\/tr><tr><td style=\"vertical-align:top;\"><strong>~\u300c\u3044\u300d\u307e\u3059\u2192~\u300c\u3046\u300d<\/strong><\/td><td style=\"vertical-align:top;\"><strong>\u301c\u307e\u3059\u2192\u301c\u308b<\/strong><\/td><td style=\"vertical-align:top;\"><p><strong>\u3057\u307e\u3059\u2192\u3059\u308b<\/strong><\/p><p><strong>\u6765\u307e\u3059\u2192\u304f\u308b<\/strong><\/p><\/td><\/tr><\/tbody><\/table><\/figure><p><strong>2.<\/strong><\/p><p><strong>2.1. \u8da3\u5473\uff08\u3057\u3085\u307f\uff09\u306fV\u308b\u3053\u3068\u3067\u3059<\/strong><\/p><figure class=\"table\" style=\"width:75.77%;\"><table class=\"ck-table-resized\"><colgroup><col style=\"width:100%;\"><\/colgroup><tbody><tr><td style=\"vertical-align:top;\"><ul style=\"list-style-type:disc;\"><li><p>\u5f1f\uff08\u304a\u3068\u3046\u3068\uff09\u306e<strong><u>\u8da3\u5473\uff08\u3057\u3085\u307f\uff09\u306f<\/u><\/strong>\u3001\u30de\u30f3\u30ac\u3092\u8aad\uff08\u3088\uff09\u3080<strong><u>\u3053\u3068<\/u><\/strong>\u3068\u3001\u30b5\u30c3\u30ab\u30fc\u3092\u3059\u308b<strong><u>\u3053\u3068\u3067\u3059<\/u><\/strong>\u3002<\/p><p>&nbsp;&nbsp;S\u1edf th\u00edch c\u1ee7a em t\u00f4i l\u00e0 \u0111\u1ecdc truy\u1ec7n tranh v\u00e0 ch\u01a1i b\u00f3ng \u0111\u00e1.<\/p><\/li><\/ul><\/td><\/tr><\/tbody><\/table><\/figure><p><u>a. S\u1eed d\u1ee5ng<\/u>:&nbsp;S\u1edf th\u00edch l\u00e0 \u2026<\/p><p><u>b. C\u1ea5u tr\u00fac<\/u>:<\/p><figure class=\"table\" style=\"width:39.57%;\"><table class=\"ck-table-resized\"><colgroup><col style=\"width:100%;\"><\/colgroup><tbody><tr><td style=\"background-color:hsl(0, 0%, 90%);\"><strong>\u3057\u3085\u307f\u3000\u306f\u3000\u3058\u3057\u3087\u5f62\uff08V\u308b\uff09\u3000\uff0b\u3000\u3053\u3068\u3067\u3059<\/strong><\/td><\/tr><\/tbody><\/table><\/figure><p>&nbsp;<\/p><p><strong>2.2. V\u308b\u306e\u304cA<\/strong><\/p><figure class=\"table\" style=\"width:39.1%;\"><table class=\"ck-table-resized\"><colgroup><col style=\"width:100%;\"><\/colgroup><tbody><tr><td style=\"vertical-align:top;\"><ul style=\"list-style-type:disc;\"><li><p>\u30ea\u3055\u3093\u306f\u672c\u3092\u3088\u3080<strong><u>\u306e\u304c<\/u><\/strong>\u597d\u304d\u3067\u3059\u3002<\/p><p>B\u1ea1n Li th\u00edch \u0111\u1ecdc s\u00e1ch.<\/p><\/li><li><p>\u304b\u306e\u3058\u3087\u306f\u8a71\u3059<strong><u>\u306e\u304c<\/u><\/strong>\u306f\u3084\u3044\u3067\u3059\u3002<\/p><p>C\u00f4 \u1ea5y n\u00f3i nhanh.<\/p><\/li><\/ul><\/td><\/tr><\/tbody><\/table><\/figure><p><br><u>a. S\u1eed d\u1ee5ng:&nbsp;<\/u><\/p><p>Bi\u1ebfn \u0111\u1ed9ng t\u1eeb V th\u00e0nh danh t\u1eeb. Vi\u1ec7c V th\u00ec A. A l\u00e0 t\u00ednh t\u1eeb ch\u1ec9 s\u1edf th\u00edch, k\u1ef9 n\u0103ng, n\u0103ng l\u1ef1c nh\u01b0: \u3059\u304d\u3001\u304d\u3089\u3044\u3001\u3058\u3087\u3046\u305a\u3001\u3078\u305f\u3001\u306f\u3084\u3044\u3001\u304a\u305d\u3044\u3001\u2026<\/p><p><u>b. C\u1ea5u tr\u00fac:<\/u><\/p><figure class=\"table\" style=\"width:32.97%;\"><table class=\"ck-table-resized\"><colgroup><col style=\"width:100%;\"><\/colgroup><tbody><tr><td style=\"background-color:hsl(0, 0%, 90%);\"><strong>\u3058\u3057\u3087\u5f62\uff08V\u308b\uff09\uff0b\u3000\u306e\u3000\u304c\u3000A\u3067\u3059<\/strong><\/td><\/tr><\/tbody><\/table><\/figure><p style=\"text-align:center;\">&nbsp;<\/p><p><strong>2.3. V\u308b\u306e\u306fA<\/strong><\/p><figure class=\"table\" style=\"width:39.33%;\"><table class=\"ck-table-resized\"><colgroup><col style=\"width:100%;\"><\/colgroup><tbody><tr><td style=\"vertical-align:top;\"><ul style=\"list-style-type:disc;\"><li><p>\u4e00\u4eba\u3067\u4f4f\u3080<strong><u>\u306e\u306f<\/u><\/strong>\u3055\u3073\u3057\u3044\u3067\u3059\u3002<\/p><p>(Vi\u1ec7c) s\u1ed1ng m\u1ed9t m\u00ecnh th\u00ec bu\u1ed3n.<\/p><\/li><li><p>\u304b\u3093\u3058\u3092\u899a\u3048\u308b<strong><u>\u306e\u306f<\/u><\/strong>\u305f\u3044\u3078\u3093\u3067\u3059\u3002<\/p><p>(Vi\u1ec7c) nh\u1edb ch\u1eef kanji th\u1eadt v\u1ea5t v\u1ea3.<\/p><\/li><\/ul><\/td><\/tr><\/tbody><\/table><\/figure><p><u>a. S\u1eed d\u1ee5ng:&nbsp;<\/u><\/p><p>Bi\u1ebfn \u0111\u1ed9ng t\u1eeb V th\u00e0nh danh t\u1eeb. Vi\u1ec7c V th\u00ec A. A l\u00e0 t\u00ednh t\u1eeb ch\u1ec9 t\u00ednh ch\u1ea5t nh\u01b0: \u3080\u305a\u304b\u3057\u3044\u3001\u3084\u3055\u3057\u3044\u3001\u304a\u3082\u3057\u308d\u3044\u3001\u305f\u306e\u3057\u3044\u3001\u305f\u3044\u3078\u3093\u3001\u2026<\/p><p><u>b. C\u1ea5u tr\u00fac:<\/u><\/p><figure class=\"table\" style=\"width:34.38%;\"><table class=\"ck-table-resized\"><colgroup><col style=\"width:100%;\"><\/colgroup><tbody><tr><td style=\"background-color:hsl(0, 0%, 90%);\"><strong>\u3058\u3057\u3087\u5f62\uff08V\u308b\uff09\uff0b\u3000\u306e\u3000\u306f\u3000A\u3067\u3059<\/strong><\/td><\/tr><\/tbody><\/table><\/figure><p style=\"text-align:center;\">&nbsp;<\/p><p><strong>3. V\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\/\u3067\u304d\u307e\u305b\u3093\u3002<\/strong><\/p><figure class=\"table\" style=\"width:36.03%;\"><table class=\"ck-table-resized\"><colgroup><col style=\"width:100%;\"><\/colgroup><tbody><tr><td style=\"vertical-align:top;\"><ul style=\"list-style-type:disc;\"><li><p>\u30d4\u30a2\u30ce\u3092\u3072\u304f<strong><u>\u3053\u3068\u304c\u3067\u304d\u307e\u3059<\/u><\/strong>\u3002<\/p><p>T\u00f4i c\u00f3 th\u1ec3 ch\u01a1i piano.<\/p><\/li><li><p>\u30d3\u30fc\u30eb\u3092\u98f2\u3080<strong><u>\u3053\u3068\u304c\u3067\u304d\u307e\u305b\u3093<\/u><\/strong>\u3002<\/p><p>&nbsp;T\u00f4i kh\u00f4ng th\u1ec3 u\u1ed1ng bia.<\/p><\/li><\/ul><\/td><\/tr><\/tbody><\/table><\/figure><p><u>a. S\u1eed d\u1ee5ng:<\/u><\/p><p>Bi\u1ec3u th\u1ecb m\u1ed9t vi\u1ec7c g\u00ec \u0111\u00f3 c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c l\u00e0m (ho\u1eb7c kh\u00f4ng th\u1ec3 \u0111\u01b0\u1ee3c l\u00e0m) b\u1edfi n\u0103ng l\u1ef1c m\u00e0 ng\u01b0\u1eddi \u0111\u00f3 c\u00f3 ho\u1eb7c 1 h\u00e0nh vi n\u00e0o c\u00f3 kh\u1ea3 n\u0103ng th\u1ef1c hi\u1ec7n \u0111\u01b0\u1ee3c (ho\u1eb7c kh\u00f4ng th\u1ef1c hi\u1ec7n \u0111\u01b0\u1ee3c) do ho\u00e0n c\u1ea3nh \u0111\u00f3 t\u1ea1o ra.&nbsp;<\/p><p><u>b. C\u1ea5u tr\u00fac:<\/u><\/p><figure class=\"table\" style=\"width:52.3%;\"><table class=\"ck-table-resized\"><colgroup><col style=\"width:100%;\"><\/colgroup><tbody><tr><td style=\"background-color:hsl(0, 0%, 90%);\"><p style=\"text-align:center;\"><strong>&nbsp;N\/\u3058\u3057\u3087\u5f62\uff08V\u308b\uff09\u3000\uff0b\u3000\u3053\u3068\u304c\u3000 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \u3067\u304d\u307e\u3059<\/strong><\/p><p style=\"text-align:center;\"><strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\u3067\u304d\u307e\u305b\u3093<\/strong><\/p><\/td><\/tr><\/tbody><\/table><\/figure><p style=\"text-align:center;\">&nbsp;<\/p><p>&nbsp;&nbsp; \u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000<\/p><p><strong><u>B. M\u1ed9t s\u1ed1 c\u00e1ch di\u1ec5n \u0111\u1ea1t hay d\u00f9ng:<\/u><\/strong><\/p><p><strong>4. \u305d\u308c\u3067<\/strong><\/p><figure class=\"table\" style=\"width:43.81%;\"><table class=\"ck-table-resized\"><colgroup><col style=\"width:100%;\"><\/colgroup><tbody><tr><td style=\"vertical-align:top;\"><ul style=\"list-style-type:disc;\"><li><p>\u30d0\u30b9\u304c\u6765\u307e\u305b\u3093\u3002<strong><u>\u305d\u308c\u3067<\/u><\/strong>\u3001\u3042\u308b\u304d\u307e\u3057\u305f\u3002<\/p><p>Xe bu\u00fdt kh\u00f4ng \u0111\u1ebfn. V\u00ec th\u1ebf t\u00f4i \u0111\u00e3 \u0111i b\u1ed9.&nbsp;<\/p><\/li><li><p>\u96e8\u304c\u3075\u3063\u3066\u3044\u307e\u3059\u3002<strong><u>\u305d\u308c\u3067<\/u><\/strong>\u3001\u5bb6\u306b\u3044\u307e\u3059\u3002<\/p><p>Tr\u1eddi \u0111ang m\u01b0a. V\u00ec th\u1ebf t\u00f4i s\u1ebd \u1edf nh\u00e0.<\/p><\/li><\/ul><\/td><\/tr><\/tbody><\/table><\/figure><p><u>a. S\u1eed d\u1ee5ng:&nbsp;<\/u><\/p><p>V\u00ec th\u1ebf. T\u1eeb nguy\u00ean nh\u00e2n, l\u00fd do d\u1eabn \u0111\u1ebfn m\u1ed9t vi\u1ec7c x\u1ea3y ra trong th\u1ef1c t\u1ebf.<\/p><p><u>b. C\u1ea5u tr\u00fac:\u3000<\/u><\/p><figure class=\"table\" style=\"width:16.23%;\"><table class=\"ck-table-resized\"><colgroup><col style=\"width:100%;\"><\/colgroup><tbody><tr><td style=\"background-color:hsl(0, 0%, 90%);\"><p style=\"text-align:center;\">&nbsp;<strong>A\u305d\u308c\u3067B<\/strong><\/p><\/td><\/tr><\/tbody><\/table><\/figure>\n    <\/div>\n"}