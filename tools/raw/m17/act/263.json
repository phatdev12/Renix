{"data":"<div class=\"rounded bg-white h-100\">\n    <div class=\"container-fluid\">\n        <div class=\"px-3 pt-3\">\n            <div id=\"player\" class=\"d-none\"><\/div>\n            <div class=\"dur\"><\/div>\n            <h1 class=\"m-0 font-weight-600\">SE 13 - \u8aad\u307f\u7269<\/h1>\n                    <\/div>\n        <div class=\"px-3 pt-3\">\n                            <div class=\"w-100 view-reader-full-screen border-file-read rounded d-flex justify-content-center align-items-center\">\r\n    <div class=\"text-window overflow-auto p-2 thin-scrollbar-thumb-route-gray thin-scrollbar-lg w-100 h-100 text-gray-reader ck-content\">\r\n        <p><span style=\"font-size:18px;\"><strong>\u6b66\u7530\u3055\u3093\u304c\u3001\u30d6\u30ed\u30b0\u3067\u81ea\u5206\u306e\u4f1a\u793e\u306e\u671d\u306b\u3064\u3044\u3066\u7d39\u4ecb\u3057\u307e\u3059\u3002<\/strong><\/span><\/p><h1 style=\"text-align:center;\">\u3010\u79c1\u306e\u4f1a\u793e\u306e\u671d\u3011<\/h1><p><span style=\"font-size:18px;\">\u79c1\u306e\u4f1a\u793e\u306f8\u664240\u5206\u304c\u59cb\u696d\u6642\u9593\u3067\u3059\u30028\u664240\u5206\u306b\u306a\u3063\u305f\u3089\u300130\u4eba\u306e\u90e8\u54e1\u304c\u671d\u793c\u3092\u3057\u307e\u3059\u3002<\/span><br><span style=\"font-size:18px;\">\u671d\u793c\u3067\u306f\u3001\u6bce\u65e5\u4e00\u4eba\u304c3\u5206\u304f\u3089\u3044\u8a71\u3057\u307e\u3059\u3002\u305d\u306e\u4eba\u306f\u305d\u306e\u65e5\u306e\u30c6\u30fc\u30de\u3092\u6c7a\u3081\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u6700\u8fd1\u697d\u3057\u304b\u3063\u305f\u3053\u3068\u300d\u3084\u3001\u300c\u304a\u3044\u3057\u3044\u30ec\u30b9\u30c8\u30e9\u30f3\u300d\u306b\u3064\u3044\u3066\u8a71\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u307f\u3093\u306a\u306e\u524d\u3067\u8a71\u3059\u8a13\u7df4\u3067\u3059\u3002<\/span><br><span style=\"font-size:18px;\">\u671d\u793c\u306e\u3042\u3068\u3001\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u30c1\u30fc\u30e0\u5358\u4f4d\u3067\u300c\u30ab\u30f3\u30d0\u30f3\