{"data":"<div class=\"rounded bg-white h-100\">\n    <div class=\"container-fluid\">\n        <div class=\"px-3 pt-3\">\n            <div id=\"player\" class=\"d-none\"><\/div>\n            <div class=\"dur\"><\/div>\n            <h1 class=\"m-0 font-weight-600\">SE 14 - \u8aad\u307f\u7269<\/h1>\n                    <\/div>\n        <div class=\"px-3 pt-3\">\n                            <div class=\"w-100 view-reader-full-screen border-file-read rounded d-flex justify-content-center align-items-center\">\r\n    <div class=\"text-window overflow-auto p-2 thin-scrollbar-thumb-route-gray thin-scrollbar-lg w-100 h-100 text-gray-reader ck-content\">\r\n        <p><span style=\"font-size:18px;\"><strong>\u30a4\u30f3\u30bf\u30fc\u30f3\u751f\u304c\u3001\u6b66\u7530\u3055\u3093\u306b\u4ed5\u4e8b\u306b\u3064\u3044\u3066\u30a4\u30f3\u30bf\u30d3\u30e5\u30fc\u3057\u307e\u3059\u3002<\/strong><\/span><\/p><h1 style=\"text-align:center;\">\u3010\u30a4\u30f3\u30bf\u30d3\u30e5\u30fc\uff1a\u30a8\u30f3\u30b8\u30cb\u30a2\u306e\u4ed5\u4e8b\u3011<\/h1><p><span style=\"font-size:18px;\">Q\uff1a\u30a8\u30f3\u30b8\u30cb\u30a2\u306b\u306a\u3063\u305f\u304d\u3063\u304b\u3051\u306f\u4f55\u3067\u3059\u304b\u3002<\/span><br><span style=\"font-size:18px;\">A\uff1a\u79c1\u306f\u4e2d\u5b66\u751f\u306e\u3053\u308d\u304b\u3089\u30b3\u30f3\u30d4\u30e5\u30fc\u30bf\u30fc\u304c\u597d\u304d\u3067\u3057\u305f\u3002\u305d\u308c\u3067\u3001\u5927\u5b66\u3067\u60c5\u5831\u51e6\u7406\u5de5\u5b66\u3092\u52c9\u5f37\u3057\u307e\u3057\u305f\u3002\u5927\u5b66\u3092\u5352\u696d\u3057\u3066\u3001\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u30a8\u30f3\u30b8\u30cb\u30a2\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u5165\u793e\u3057\u3066\u3001\u6700\u521d\u306e5\u5e74\u9593\u306f\u30d7\u30ed\u30b0\u30e9\u30de\u30fc\u3092\u3057\u3066\u3044\u307e\u3057\u305f\u3002\u30d7\u30ed\u30b0\u30e9\u30e0\u958b\u767a\u304c\u597d\u304d\u3060\u3063\u305f\u306e\u3067\u3001\u4ed5\u4e8b\u304c\u697d\u3057\u304b\u3063\u305f\u3067\u3059\u3002<\/span><